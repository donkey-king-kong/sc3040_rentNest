# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Protomaps API key for online map tiles (https://protomaps.com/account).
# Optional when the offline map assets are installed (npm run map-assets).
EXPO_PUBLIC_PROTOMAPS_KEY=

# Optional: your own PMTiles file URL, used when no Protomaps key is set.
EXPO_PUBLIC_PMTILES_URL=

# Optional: backend URL override. Leave blank to use this machine's address on port 8080.
# Physical phone: use your computer's Wi-Fi IP address, e.g. http://192.168.1.10:8080
# Android emulator defaults to http://10.0.2.2:8080 when this variable is unset.
EXPO_PUBLIC_API_BASE_URL=
